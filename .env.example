# Database
DATABASE_URL=postgresql://crm_user:crm_pass@localhost:5432/crm_fte
DB_POOL_MIN=2
DB_POOL_MAX=10

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_INCOMING=fte.tickets.incoming
KAFKA_TOPIC_OUTGOING=fte.responses.outgoing

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Twilio (WhatsApp)
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_PHONE_NUMBER=+14155238886
WHATSAPP_PHONE_NUMBER=whatsapp:+923313494999
WHATSAPP_MOCK=false

# Gmail Configuration
GMAIL_SENDER_EMAIL=support@yourdomain.com
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_POLLING_INTERVAL=30
GMAIL_MOCK=false

# App
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://crm_user:crm_pass@localhost:5432/crm_fte
DB_POOL_MIN=2
DB_POOL_MAX=10

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_INCOMING=fte.tickets.incoming
KAFKA_TOPIC_OUTGOING=fte.responses.outgoing

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Twilio (WhatsApp)
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_ACCOUNT_SID=your-twilio-account-sid

# App
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
